{
  "name": "kadochiapp",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "setup": "cp -n .env.example .env || true",
    "docker:up": "docker compose -f docker-compose.local.yml up --build",
    "docker:up:d": "docker compose -f docker-compose.local.yml up --build -d",
    "docker:down": "docker compose -f docker-compose.local.yml down",
    "docker:down:volumes": "docker compose -f docker-compose.local.yml down --volumes",
    "docker:logs": "docker compose -f docker-compose.local.yml logs -f",
    "docker:restart": "npm run docker:down && npm run docker:up"
  },
  "dependencies": {
    "nextjs-toploader": "^3.9.17"
  }
}
