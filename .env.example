# Copy this file to .env before starting the stack.
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=wordpress_dev_password
MYSQL_ROOT_PASSWORD=root_dev_password

WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=wordpress_dev_password
WORDPRESS_DB_HOST=mysql:3306

WORDPRESS_URL=http://localhost:8080
WORDPRESS_INTERNAL_URL=http://wordpress
NEXT_PUBLIC_WORDPRESS_URL=http://localhost:8080
