# Copy this file to .env before starting the stack.
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=wordpress_dev_password
MYSQL_ROOT_PASSWORD=root_dev_password

# Production Compose requires the two values above. On an existing deployment,
# copy the current database passwords exactly; changing these variables does not
# rotate credentials stored in an existing MySQL volume.

# Container-scoped production resolvers. Verify reachability from the deployment
# host before overriding these defaults.
KADOCHI_DNS_PRIMARY=217.218.127.127
KADOCHI_DNS_SECONDARY=9.9.9.9

# Bounded Docker JSON logs (per container).
KADOCHI_LOG_MAX_SIZE=10m
KADOCHI_LOG_MAX_FILES=5

# WordPress uses a Redis database separate from Next.js (which uses database 0).
KADOCHI_WP_REDIS_DATABASE=1
KADOCHI_WP_REDIS_PREFIX=kadochi:wordpress:
KADOCHI_WP_REDIS_DISABLED=false

# Production keeps the existing overdue WP-Cron backlog paused until a system
# scheduler and gradual queue-drain procedure are explicitly deployed.
KADOCHI_DISABLE_WP_CRON=true

WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=wordpress_dev_password
WORDPRESS_DB_HOST=mysql:3306

WORDPRESS_INTERNAL_URL=http://wordpress
NEXT_PUBLIC_WORDPRESS_URL=http://localhost:8080

# WordPress owns OTP and JWT authentication. In `local` or `development`, use
# phone 09121234567 and OTP 1234; no SMS is sent. For production Compose,
# set the MeliPayamak relay below in this root `.env` file (or inject it from
# the deployment environment).
WP_ENVIRONMENT_TYPE=development
MELIPAYAMAK_OTP_URL=https://your-melipayamak-relay.example/otp
SMS_USERNAME=replace-me
SMS_PASSWORD=replace-me

# Official ZarinPal for WooCommerce gateway ID. Merchant credentials and gateway
# enablement are configured in WooCommerce after the provisioned plugin is active.
KADOCHI_PAYMENT_METHOD_ID=WC_ZPal
KADOCHI_FRONTEND_URL=http://localhost:3000

# Production editorial automation. Use long, independent random values and
# inject them through the server's secret manager or its root .env file.
KADOCHI_EDITORIAL_API_SECRET=replace-with-a-long-random-secret
KADOCHI_REVALIDATE_SECRET=replace-with-a-different-long-random-secret
KADOCHI_INTERNAL_API_SECRET=replace-with-a-third-independent-random-secret
