# Copy this file to .env before starting the stack.
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=wordpress_dev_password
MYSQL_ROOT_PASSWORD=root_dev_password

WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=wordpress_dev_password
WORDPRESS_DB_HOST=mysql:3306

WORDPRESS_URL=http://localhost:8080
WORDPRESS_INTERNAL_URL=http://wordpress
NEXT_PUBLIC_WORDPRESS_URL=http://localhost:8080

# Local development uses the sample phone 09121234567 and static OTP 1234.
# The server refuses this mode in production.
KADOCHI_AUTH_MODE=local

# Production OTP via the MeliPayamak relay API used by the v2 app. The relay
# receives POST { "to": "0912..." } and returns the sent 4–6 digit code in a
# `code`, `otp`, `data`, or `result` field. Keep all values server-only.
# KADOCHI_AUTH_MODE=melipayamak
# KADOCHI_AUTH_SECRET=replace-with-at-least-32-random-characters
# MELIPAYAMAK_OTP_URL=https://your-melipayamak-relay.example/otp
# REDIS_URL=redis://redis:6379
# WOO_CONSUMER_KEY=ck_...
# WOO_CONSUMER_SECRET=cs_...
# OTP_CODE_TTL_SEC=180
# OTP_ATTEMPT_RATE_PER_HOUR=3
# OTP_VERIFY_ATTEMPTS=5

# wordpress-jwt remains available for deployments that already provide their
# own WordPress OTP and JWT endpoints.
# KADOCHI_AUTH_MODE=wordpress-jwt
# WORDPRESS_OTP_REQUEST_PATH=/wp-json/kadochi/v1/auth/otp/start
# WORDPRESS_OTP_VERIFY_PATH=/wp-json/kadochi/v1/auth/otp/verify

# Do not enable until the Phase 0 checkout decisions are documented and smoke-tested.
# KADOCHI_CHECKOUT_ENABLED=false
