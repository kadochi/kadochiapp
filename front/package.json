{
  "name": "kadochi-front",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev --webpack --hostname 0.0.0.0",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:lighthouse:mobile": "AUDIT_PRESET=mobile lhci autorun --config=./lighthouserc.cjs",
    "audit:lighthouse:desktop": "AUDIT_PRESET=desktop lhci autorun --config=./lighthouserc.cjs",
    "audit:lighthouse:agentic": "node ./scripts/assert-agentic-audits.mjs",
    "audit:lighthouse": "npm run audit:lighthouse:mobile && npm run audit:lighthouse:desktop && npm run audit:lighthouse:agentic"
  },
  "dependencies": {
    "@next/third-parties": "16.2.11",
    "@types/leaflet": "^1.9.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.21",
    "leaflet": "^1.9.4",
    "lottie-react": "^2.4.1",
    "lucide-react": "^1.24.0",
    "next": "16.2.11",
    "radix-ui": "^1.6.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.35.3",
    "swiper": "^14.0.5",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.1",
    "eslint-config-next": "16.2.11",
    "lighthouse": "^13.4.1",
    "tailwindcss": "^4.3.2",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  }
}
