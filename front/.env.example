# ============================================================
# front/.env.example — copy to front/.env.local (local dev)
#                   or front/.env.production (production)
#
# When running Next.js inside Docker (via docker-compose), the
# WP_BASE_URL, WOO_BASE_URL, and NEXT_PUBLIC_SITE_URL values
# are automatically overridden by the compose file for the target
# Docker environment. You still need the secrets below
# (WP_APP_PASS, WOO_CONSUMER_KEY, etc.).
# ============================================================

# ── Site ────────────────────────────────────────────────────
# Public URL of this Next.js app.
# Local:      http://localhost:3000
# Production: https://kadochi.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cookie domain (leave empty for localhost, set to .kadochi.com in prod)
COOKIE_DOMAIN=
# Set to false when serving over plain HTTP (e.g. local Docker without TLS)
# COOKIE_SECURE=false

# ── WordPress / WooCommerce API ──────────────────────────────
# Used when running Next.js directly on the host (npm run dev).
# Docker Compose overrides these to http://wordpress automatically.
WP_BASE_URL=http://localhost:8080
WOO_BASE_URL=http://localhost:8080
# Production Docker: INTERNAL_SITE_ORIGIN=http://127.0.0.1:3000 (set in docker-compose.yml)
# LOG_UPSTREAM_DEBUG=1  # log full fetch error stacks (optional)
# Public WordPress URL for client-side direct fallback fetches (browser)
NEXT_PUBLIC_WP_BASE_URL=http://localhost:8080

# WordPress Application Password — create in WP admin:
# Users → Profile → Application Passwords
WP_APP_USER=api-kadochi
WP_APP_PASS=xxxx xxxx xxxx xxxx xxxx xxxx

# WooCommerce REST API keys — create in:
# WooCommerce → Settings → Advanced → REST API → Add key (Read/Write)
WOO_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOO_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── CORS ────────────────────────────────────────────────────
# Comma-separated list of allowed origins for /api/wp/* proxy.
# Local:      http://localhost:3000
# Production: https://kadochi.com,https://www.kadochi.com
ALLOWED_ORIGINS=http://localhost:3000

# ── Auth / Security ──────────────────────────────────────────
# Use strong random strings in production (e.g. openssl rand -hex 32)
KADOCHI_JWT_SECRET=change-me-to-a-random-secret
CSRF_SECRET=change-me-to-a-random-secret
REVALIDATE_SECRET=change-me-to-a-random-secret

# ── Payment — Zarinpal (zarinpal-node-sdk) ───────────────────
# ZARINPAL_MODE selects sandbox vs production API (not NODE_ENV alone).
# Use "sandbox" for local testing, "production" for live payments.
# If unset, sandbox is used when NODE_ENV is not "production".
ZARINPAL_MERCHANT_ID=your-merchant-id
ZARINPAL_MODE=sandbox
# Full absolute URL sent to Zarinpal as callback_url (not joined with site origin)
ZARINPAL_CALLBACK_URL=https://kadochi.com/checkout/zp-callback

# ── Redis (OTP codes + rate limits) ──────────────────────────
# Docker:  redis://redis:6379
# Host dev (npm run dev): redis://localhost:6379
REDIS_URL=redis://redis:6379

# ── SMS / OTP ────────────────────────────────────────────────
MELIPAYAMAK_OTP_URL=
SMS_USERNAME=
SMS_PASSWORD=
OTP_CODE_TTL_SEC=180
OTP_ATTEMPT_RATE_PER_HOUR=3
# Local only: skip SMS for OTP_DEV_PHONE and accept OTP_DEV_BYPASS code (0000)
OTP_DEV_BYPASS=1
OTP_DEV_PHONE=09120000000
NEXT_PUBLIC_OTP_DEV_PHONE=09120000000

# ── Analytics ────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=
