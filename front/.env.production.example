# Copy this file to .env.production on the production host and replace every
# placeholder before running the main docker-compose.yml stack.

WP_APP_USER=replace-me
WP_APP_PASS=replace-me
WOO_CONSUMER_KEY=replace-me
WOO_CONSUMER_SECRET=replace-me

KADOCHI_PAYMENT_METHOD_ID=WC_ZPal

ZARINPAL_MERCHANT_ID=replace-me
ZARINPAL_CALLBACK_URL=https://kadochi.com/checkout/zp-callback

CSRF_SECRET=replace-me
# The production Compose stack injects this value from the root deployment
# environment as KADOCHI_REVALIDATE_SECRET, so WordPress can invalidate only
# the editorial cache after a successful write.
